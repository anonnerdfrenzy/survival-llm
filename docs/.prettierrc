{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "printWidth": 160,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.jsx", "*.tsx"],
      "options": {
        "singleQuote": true,
        "jsxSingleQuote": true
      }
    }
  ]
}
